# ── Tienda 1: Costa Rica ──────────────────────────────
STORE_CR_NAME=Mireva Costa Rica
STORE_CR_BOXFUL_EMAIL=tu@email.com
STORE_CR_BOXFUL_PASSWORD=tu_password
STORE_CR_SHOPIFY_URL=mireva-costa-rica.myshopify.com
STORE_CR_SHOPIFY_TOKEN=shpat_xxxxxxxxxxxxxxxxxx

# ── Tienda 2: Honduras ────────────────────────────────
STORE_HN_NAME=Mireva Honduras
STORE_HN_BOXFUL_EMAIL=tu@email.com
STORE_HN_BOXFUL_PASSWORD=tu_password
STORE_HN_SHOPIFY_URL=mireva-honduras.myshopify.com
STORE_HN_SHOPIFY_TOKEN=shpat_xxxxxxxxxxxxxxxxxx

# ── Supabase (opcional) ───────────────────────────────
# SUPABASE_KEY se usa solo desde Python/server-side.
# No pegues una service_role key ni una sb_secret_* en dashboard/index.html.
SUPABASE_URL=https://xxxx.supabase.co
SUPABASE_KEY=sb_secret_xxxxxxxxxxxxxxxxxx

# Para dashboard/index.html usa la anon public key de Supabase Settings > API.
# SUPABASE_ANON_KEY=eyJhbGciOi...

# Dashboard en Vercel (opcional)
# DASHBOARD_USER=admin
# DASHBOARD_PASSWORD=una_contraseña_larga

# Importacion diaria de ventas Shopify en Vercel (opcional)
# SHOPIFY_API_VERSION=2026-04
# SHOPIFY_SALES_TIMEZONE=America/Lima
# CRON_SECRET=una_llave_larga_para_proteger_el_endpoint

# Google Sheets privados para Ads (opcional)
# Crea una Google Service Account, comparte el Sheet con este email y pega
# estas variables en Vercel y/o en .env local.
GOOGLE_SERVICE_ACCOUNT_EMAIL=tu-service-account@tu-proyecto.iam.gserviceaccount.com
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
